# Pick ONE Jev backend. Official TypeSafe is preferred if you have a key.

# Official TypeSafe Jev (closed model, hosted API):
# Get a key at https://console.typesafe.ai/settings/keys
# Waitlist: https://typesafe.ai
TYPESAFE_API_KEY=

# Optional fallback if you are still on the TypeSafe waitlist:
# Sign in at https://jev-agent.com/api-access and paste a jv_live_ key.
JEV_AGENT_KEY=

# Optional overrides
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0

# Laya runs locally. Use cuda when NVIDIA + a CUDA PyTorch wheel are available.
# auto picks cuda if torch.cuda.is_available() else cpu.
LAYA_DEVICE=cuda
LAYA_MODEL=convaiinnovations/laya
# Faster on small GPUs. Omit this to use the English large model.
LAYA_SUBFOLDER=multilingual
